# ============================================================
# GriviTness Backend — contoh environment variables
# Copy file ini jadi .env lalu isi nilainya.
# JANGAN commit .env ke git.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# Origin yang diizinkan akses API, pisahkan dengan koma.
# Expo dev pakai skema exp://, web Vite biasanya http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Directus (data layer + file storage) ---
DIRECTUS_URL=https://database.url.com

# Static token milik user admin.
# Ambil di: Directus -> User Directory -> klik user admin -> field "Token"
# -> Generate Token -> WAJIB klik Save, kalau tidak token-nya belum aktif.
DIRECTUS_ADMIN_TOKEN=

# Kalau true, setiap register juga membuat entri di directus_users
# supaya user terlihat di admin panel Directus.
# Set false kalau tidak butuh sinkronisasi user ke Directus.
DIRECTUS_SYNC_USERS=true

# --- JWT ---
# Generate nilai acak, jangan pakai contoh apapun.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Rate limit ---
# Batas percobaan register & login per IP. Longgarkan saat development kalau
# sering mentok waktu mengetes. Otomatis mati saat NODE_ENV=test.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=60

# --- Groq Vision (dipakai module food & body-photos) ---
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
