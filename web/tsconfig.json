{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Tanpa `baseUrl`, sudah usang di TypeScript 6 dan berhenti berfungsi di 7.
    // Sejak TS 5, `paths` tanpa baseUrl dihitung relatif terhadap berkas ini,
    // jadi hasilnya sama persis tanpa opsi yang akan hilang.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}
